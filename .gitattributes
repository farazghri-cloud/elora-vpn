# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout, but stored as LF in the repo
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Denote all binary files
*.png binary
*.ico binary
*.woff2 binary
